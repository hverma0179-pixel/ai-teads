PORT=3000
NODE_ENV=development

# Safety defaults. The app also stores these in data/settings.json after first save.
PAPER_TRADING=true
REAL_TRADING=false
DIRECT_TRADE=false

# Broker selection: mock, upstox, or angelone
BROKER=mock
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# Optional AI API keys. The starter app simulates AI voting locally.
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=
AI_API_KEY_4=
AI_API_KEY_5=
AI_API_KEY_6=
AI_API_KEY_7=
AI_API_KEY_8=
AI_API_KEY_9=
AI_API_KEY_10=
